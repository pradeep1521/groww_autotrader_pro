# Groww API Credentials
GROWW_ACCESS_TOKEN=your_access_token_here
GROWW_API_KEY=your_api_key_here
GROWW_API_SECRET=your_api_secret_here

# Application Settings
APP_MODE=paper  # paper or live
DEFAULT_RISK_PER_TRADE=500  # ₹ risk per trade
MAX_OPEN_POSITIONS=5
DAILY_LOSS_LIMIT=5000  # ₹ max loss per day

# Screener Settings
SCREENER_UNIVERSE=nifty50  # nifty50, nifty_next50, nifty500
SCREENER_SCAN_INTERVAL=900  # seconds (15 min)
SCREENER_ENABLED=true

# Database
DB_PATH=./data/trades.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/trader.log

# Market Hours
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
MARKET_PRE_CLOSE_TIME=15:20
