# ─────────────────────────────────────────────────────────────────────────────
#  Kotak Neo NeoTrade API – Environment Variables Template
#  Copy this file to .env (at the workspace root) and fill in your values.
#  NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Kotak Neo Trade API (₹0 brokerage) ──────────────────────────────────────
#
# 1. Get your Consumer Key directly from the Kotak Neo app (no external registration):
#    Kotak Neo app / web → Invest tab → Trade API card → Generate Application → copy token
# 2. Register TOTP at: kotaksecurities.com → platform → kotak-neo-trade-api → Register for TOTP
#    Scan the QR code in your authenticator app. The base-32 seed is in the QR data.
# 3. Whitelist your IP: https://www.kotakneo.com/platform/kotak-neo-trade-api/static-ip-details/
# Support: support@kotakneo.com | Docs: https://www.kotakneo.com/platform/kotak-neo-trade-api/

KOTAK_CONSUMER_KEY=your_consumer_key_here
KOTAK_USERNAME=your_kotak_neo_user_id
KOTAK_PASSWORD=your_kotak_neo_password
KOTAK_TOTP_SEED=BASE32TOTPSEEDGOESHERE

# ── Broker selection ─────────────────────────────────────────────────────────
# Set to 'kotak_neo' to route live orders through Kotak Neo
BROKER=kotak_neo
APP_MODE=paper          # paper | live

# ── (existing) Groww credentials ─────────────────────────────────────────────
# GROWW_ACCESS_TOKEN=
# GROWW_API_KEY=
# GROWW_API_SECRET=

# ── (existing) Zerodha credentials ───────────────────────────────────────────
# ZERODHA_API_KEY=
# ZERODHA_API_SECRET=
# ZERODHA_ACCESS_TOKEN=
